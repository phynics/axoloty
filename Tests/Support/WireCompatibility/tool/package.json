{
  "name": "@axoloty/wire-tool",
  "version": "0.0.0",
  "private": true,
  "description": "npx-runnable CLI for capturing CoatyJS wire-compatibility traffic and writing JSONL + manifests (replaces the Python wire-test harness).",
  "license": "MIT",
  "type": "module",
  "bin": {
    "axoloty-wire": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test dist/*.test.js",
    "golden:generate": "npm run build && node dist/goldenCorpusCli.js",
    "verify:golden": "npm run build && node dist/goldenVerifyCli.js",
    "dev": "tsx src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cbor-x": "1.6.6",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
