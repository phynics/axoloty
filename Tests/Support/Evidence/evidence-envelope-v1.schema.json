{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://axoloty.dev/schemas/evidence-envelope-v1.json",
  "title": "Axoloty release evidence envelope v1",
  "type": "object",
  "required": ["envelopeSchema", "gate", "gateSchema", "subject", "producer", "artifacts", "result", "payload"],
  "properties": {
    "envelopeSchema": { "const": 1 },
    "gate": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "gateSchema": { "type": "integer", "minimum": 1 },
    "subject": { "$ref": "#/$defs/subject" },
    "producer": { "$ref": "#/$defs/producer" },
    "artifacts": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/artifact" } },
    "result": { "enum": ["passed", "failed"] },
    "payload": {}
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "subject": {
      "type": "object",
      "required": ["repository", "commit", "tree", "version", "clean"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "commit": { "$ref": "#/$defs/sha" },
        "tree": { "$ref": "#/$defs/sha" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[^ ]+)?(?:\\+[^ ]+)?$" },
        "clean": { "const": true }
      },
      "additionalProperties": false
    },
    "producer": {
      "type": "object",
      "required": ["id", "version", "disposition", "provenance"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "disposition": { "enum": ["current-run", "imported"] },
        "provenance": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/provenance" }] }
      },
      "allOf": [
        { "if": { "properties": { "disposition": { "const": "imported" } } }, "then": { "required": ["provenance"], "properties": { "provenance": { "$ref": "#/$defs/provenance" } } } },
        { "if": { "properties": { "disposition": { "const": "current-run" } } }, "then": { "properties": { "provenance": { "type": "null" } } } }
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["issuer", "runID", "workflow", "job", "artifact", "commit"],
      "properties": {
        "issuer": { "type": "string", "minLength": 1 },
        "runID": { "type": "string", "minLength": 1 },
        "workflow": { "type": "string", "minLength": 1 },
        "job": { "type": "string", "minLength": 1 },
        "artifact": { "type": "string", "minLength": 1 },
        "commit": { "$ref": "#/$defs/sha" }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["role", "relativePath", "sha256", "byteCount", "mediaType"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "relativePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "byteCount": { "type": "integer", "minimum": 0 },
        "mediaType": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
