# Xcode
#
# gitignore contributors: remember to update Global/Xcode.gitignore, Objective-C.gitignore & Swift.gitignore

# OS X
.DS_Store

## Build generated
build/
DerivedData/

## Various settings
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
profile

## Other
*.moved-aside
*.xccheckout
*.xcscmblueprint
*.generated.swift

## Obj-C/Swift specific
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

# Bundler
.bundle

## Playgrounds
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager
#
# Add this line if you want to avoid checking in source code from Swift Package Manager dependencies.
# Packages/
# Package.pins
# Package.resolved
.build/
.build-output/

# Local test outputs: live captures, fuzz campaigns, and diagnostics
.testing/

# Binary-size benchmark outputs (generated by `make benchmark-size`)
.testing/benchmarks/

# SwiftPM cache shared into the wire-compatibility live-test containers
.swiftpm-cache/

# Code Injection
#
# After new code Injection tools there's a generated folder /iOSInjectionProject
# https://github.com/johnno1962/injectionforxcode

iOSInjectionProject/

# Local agentic-coding workspace (worktrees and scratch), not shared via git
.agents/
.worktree/


# DocC generated documentation build output
.docc-build/

# Python bytecode cache
__pycache__/

# Node dependencies fetched locally for the pinned CoatyJS reference agent
node_modules/

# ESP32-C6 embedded artifacts (generated by `make embedded-*`)
# .testing/ is already ignored above; these are explicit for clarity.
.testing/embedded/device-info-raw.txt
.testing/embedded/smoke-log.txt
Embedded/build/
Embedded/sdkconfig
Embedded/benchmark/build/
Embedded/benchmark/sdkconfig
Embedded/swift/build/
Embedded/swift/sdkconfig
Embedded/swift/sdkconfig.old
Embedded/swift/managed_components/
Embedded/swift/.network-build/
Embedded/swift/main/axoloty_network_config.h
# Embedded/swift/dependencies.lock is committed for reproducibility
.build-tools/
