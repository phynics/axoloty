set -eu

scratch_path=${DEBUG_BUILD_DIR:-/workspace/.build/debug-cli}
cache_path=${SPM_CACHE_DIR:-/workspace/.swiftpm-cache}
module_cache_path=${SWIFTPM_MODULECACHE_OVERRIDE:-/tmp/axoloty-debug-module-cache}

# Build the axoloty-mcp product before the managed service runner starts so its
# readiness deadline measures service startup, not SwiftPM compilation.
if [ "${1:-}" = "serve" ] && { [ "${2:-}" = "mcp" ] || [ "${2:-}" = "dev" ]; } \
    && [ -z "${AXOLOTY_MCP_EXECUTABLE:-}" ]; then
    swift build \
        --package-path /axoloty-debug \
        --scratch-path "$scratch_path" \
        --cache-path "$cache_path" \
        --disable-automatic-resolution \
        --product axoloty-mcp

    mcp_bin_dir=$(swift build \
        --package-path /axoloty-debug \
        --scratch-path "$scratch_path" \
        --cache-path "$cache_path" \
        --disable-automatic-resolution \
        --show-bin-path)
    if ! mcp_bin_dir=$(CDPATH= cd -- "$mcp_bin_dir" && pwd); then
        echo "axoloty-mcp binary directory was not found at $mcp_bin_dir after build" >&2
        exit 70
    fi
    mcp_executable="$mcp_bin_dir/axoloty-mcp"
    if [ ! -x "$mcp_executable" ]; then
        echo "axoloty-mcp product was not found at $mcp_executable after build" >&2
        exit 70
    fi
    export AXOLOTY_MCP_EXECUTABLE="$mcp_executable"
fi

exec swift run \
    --package-path /axoloty-debug \
    --scratch-path "$scratch_path" \
    --cache-path "$cache_path" \
    -Xswiftc -module-cache-path -Xswiftc "$module_cache_path" \
    --disable-automatic-resolution \
    axoloty-debug "$@"
