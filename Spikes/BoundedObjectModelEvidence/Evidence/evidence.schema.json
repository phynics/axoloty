{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axoloty G3 bounded object-model evidence",
  "oneOf": [
    {"$ref": "#/$defs/host"},
    {"$ref": "#/$defs/sanitized"},
    {"$ref": "#/$defs/embedded"}
  ],
  "$defs": {
    "identity": {
      "type": "object",
      "required": ["schemaVersion", "evidenceKind", "candidateSha"],
      "properties": {
        "schemaVersion": {"const": 1},
        "evidenceKind": {"type": "string"},
        "candidateSha": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"}
      }
    },
    "layout": {
      "oneOf": [
        {"$ref": "#/$defs/objectLayout"},
        {"$ref": "#/$defs/envelopeLayout"}
      ]
    },
    "objectLayout": {
      "type": "object",
      "required": ["measurementPoint", "axis", "type", "size", "alignment", "stride", "byteCapacity", "fieldCapacity"],
      "properties": {
        "measurementPoint": {"enum": [1, 16, 64]},
        "axis": {"const": "object"},
        "type": {"type": "string", "minLength": 1},
        "size": {"type": "integer", "minimum": 1},
        "alignment": {"type": "integer", "minimum": 1},
        "stride": {"type": "integer", "minimum": 1},
        "byteCapacity": {"enum": [1, 16, 64]},
        "fieldCapacity": {"enum": [1, 16, 64]}
      },
      "additionalProperties": false
    },
    "envelopeLayout": {
      "type": "object",
      "required": ["measurementPoint", "axis", "type", "size", "alignment", "stride", "nameCapacity", "externalIDCapacity"],
      "properties": {
        "measurementPoint": {"enum": [1, 16, 64]},
        "axis": {"const": "envelope"},
        "type": {"type": "string", "minLength": 1},
        "size": {"type": "integer", "minimum": 1},
        "alignment": {"type": "integer", "minimum": 1},
        "stride": {"type": "integer", "minimum": 1},
        "nameCapacity": {"enum": [1, 16, 64]},
        "externalIDCapacity": {"enum": [1, 16, 64]}
      },
      "additionalProperties": false
    },
    "operation": {
      "type": "object",
      "required": ["measurementPoint", "byteCapacity", "fieldCapacity", "nameCapacity", "externalIDCapacity", "objectInitialization", "envelopeInitialization", "randomizedEditRead", "saturationMeasurement", "saturationRejected", "unchangedAfterSaturation"],
      "properties": {
        "measurementPoint": {"enum": [1, 16, 64]},
        "byteCapacity": {"enum": [1, 16, 64]},
        "fieldCapacity": {"enum": [1, 16, 64]},
        "nameCapacity": {"enum": [1, 16, 64]},
        "externalIDCapacity": {"enum": [1, 16, 64]},
        "objectInitialization": {"type": "string", "minLength": 1},
        "envelopeInitialization": {"const": true},
        "randomizedEditRead": {"type": "boolean"},
        "saturationMeasurement": {"enum": ["minimum-object-rejection", "edit-capacity-failure"]},
        "saturationRejected": {"const": true},
        "unchangedAfterSaturation": {"const": true}
      },
      "additionalProperties": false
    },
    "allocation": {
      "type": "object",
      "required": ["measurementPoint", "byteCapacity", "fieldCapacity", "nameCapacity", "externalIDCapacity", "measurement", "objectInitialization", "objectWarmed", "envelopeInitialization", "envelopeWarmed"],
      "properties": {
        "measurementPoint": {"enum": [1, 16, 64]},
        "byteCapacity": {"enum": [1, 16, 64]},
        "fieldCapacity": {"enum": [1, 16, 64]},
        "nameCapacity": {"enum": [1, 16, 64]},
        "externalIDCapacity": {"enum": [1, 16, 64]},
        "measurement": {"const": "heaptrack-call-growth"},
        "objectInitialization": {"type": "integer", "minimum": 0},
        "objectWarmed": {"type": "integer", "minimum": 0},
        "envelopeInitialization": {"type": "integer", "minimum": 0},
        "envelopeWarmed": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "host": {
      "type": "object",
      "required": ["schemaVersion", "evidenceKind", "candidateSha", "toolchain", "measurementPoints", "measurementPolicy", "layouts", "operations", "allocations", "compilation", "hardware"],
      "properties": {
        "schemaVersion": {"const": 1},
        "evidenceKind": {"const": "host"},
        "candidateSha": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
        "toolchain": {"type": "string", "minLength": 1},
        "measurementPoints": {"const": [1, 16, 64]},
        "measurementPolicy": {"const": "simultaneous-object-and-envelope-specializations"},
        "layouts": {"type": "array", "minItems": 6, "maxItems": 6, "items": {"$ref": "#/$defs/layout"}},
        "operations": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/operation"}},
        "allocations": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/allocation"}},
        "compilation": {
          "type": "object",
          "required": ["debugTests", "sanitizedTests", "compileSeconds", "releaseBinaryBytes", "releaseSections"],
          "properties": {
            "debugTests": {"const": "passed"},
            "sanitizedTests": {"const": "separate-node"},
            "compileSeconds": {"type": "number", "minimum": 0},
            "releaseBinaryBytes": {"type": "integer", "minimum": 1},
            "releaseSections": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "bytes"], "properties": {"name": {"type": "string"}, "bytes": {"type": "integer", "minimum": 0}}, "additionalProperties": false}}
          },
          "additionalProperties": false
        },
        "hardware": {"const": "pending-hardware"}
      },
      "additionalProperties": false
    },
    "sanitized": {
      "type": "object",
      "required": ["schemaVersion", "evidenceKind", "candidateSha", "status", "sanitizer", "measurementPoints", "hardware"],
      "properties": {
        "schemaVersion": {"const": 1},
        "evidenceKind": {"const": "sanitized"},
        "candidateSha": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
        "status": {"const": "passed"},
        "sanitizer": {"const": "address"},
        "measurementPoints": {"const": [1, 16, 64]},
        "hardware": {"const": "pending-hardware"}
      },
      "additionalProperties": false
    },
    "embedded": {
      "type": "object",
      "required": ["schemaVersion", "evidenceKind", "candidateSha", "status", "compileSuccess", "coverage", "source", "toolchain", "compileSeconds", "firmwareBytes", "elfBytes", "mapBytes", "sections", "hardware"],
      "properties": {
        "schemaVersion": {"const": 1},
        "evidenceKind": {"const": "embedded-cross-build"},
        "candidateSha": {"type": "string", "pattern": "^[0-9a-f]{7,64}$"},
        "status": {"const": "passed"},
        "compileSuccess": {"const": true},
        "coverage": {"const": "foundation-module-linkage-only"},
        "source": {"const": "Embedded/swift"},
        "toolchain": {"type": "string", "minLength": 1},
        "compileSeconds": {"type": "number", "minimum": 0},
        "firmwareBytes": {"type": "integer", "minimum": 1},
        "elfBytes": {"type": "integer", "minimum": 1},
        "mapBytes": {"type": "integer", "minimum": 1},
        "sections": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name", "bytes"], "properties": {"name": {"type": "string", "minLength": 1}, "bytes": {"type": "integer", "minimum": 0}}, "additionalProperties": false}},
        "hardware": {"const": "pending-hardware"}
      },
      "additionalProperties": false
    }
  }
}
